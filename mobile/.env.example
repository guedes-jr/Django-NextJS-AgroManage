# Public configuration only. Use the hostname/IP reachable from the device.
# Production must use HTTPS. Never put credentials in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1/
# Public website (Next.js), used for terms, privacy and copyright links.
EXPO_PUBLIC_SITE_URL=https://fazendamais.com
# Google: public OAuth identifiers; web ID must match backend GOOGLE_OAUTH_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS additionally needs its own OAuth client and reverse-client URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
