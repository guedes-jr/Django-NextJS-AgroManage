[Unit]
Description=AgroManage Celery Worker
After=network.target postgresql.service redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/agromanage/backend
EnvironmentFile=/var/www/agromanage/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/var/www/agromanage/backend/.venv/bin/celery -A config worker --loglevel=INFO --concurrency=2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
