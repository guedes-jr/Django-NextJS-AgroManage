#!/bin/sh
# Install root-owned at /usr/local/sbin; the web user may only invoke "restart".
set -eu
if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ] || [ "$1" != "restart" ]; then
  echo "Operação não autorizada." >&2
  exit 2
fi
# Never accept a container name, shell command, session path, or Docker flags.
exec /usr/bin/docker restart --timeout 15 agromanage-wppconnect
